# Free / cheap model APIs for Open Limited (Cascade-Verify).
# No keys required to start: Kilo + LLM7 + OVH anonymous race first (Cursor Auto–style).
# Optional official free-tier keys unlock more models and higher limits.

# --- Keyless (work without env vars) ---
# KILO_SMALL_MODEL=kilo-auto/free
# KILO_LARGE_MODEL=kilo-auto/free
# LLM7_API_KEY=
# LLM7_SMALL_MODEL=turbo
# LLM7_LARGE_MODEL=turbo
# OVH_SMALL_MODEL=Mistral-7B-Instruct-v0.3
# OVH_LARGE_MODEL=Mistral-Small-3.2-24B-Instruct-2506

# --- Official free-tier keys (paste in /app/settings or here) ---
# GROQ_API_KEY=
# GROQ_SMALL_MODEL=llama-3.1-8b-instant
# GROQ_LARGE_MODEL=llama-3.3-70b-versatile

# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_SMALL_MODEL=gemini-2.0-flash
# GEMINI_LARGE_MODEL=gemini-2.0-flash

# OPENROUTER_API_KEY=
# OPENROUTER_SMALL_MODEL=openrouter/free
# OPENROUTER_LARGE_MODEL=openrouter/free
# OPENROUTER_SITE_URL=http://localhost:43127

# CEREBRAS_API_KEY=
# CEREBRAS_SMALL_MODEL=llama3.1-8b
# CEREBRAS_LARGE_MODEL=llama3.3-70b

# HF_TOKEN=
# HUGGINGFACE_API_KEY=
# HF_SMALL_MODEL=meta-llama/Llama-3.1-8B-Instruct
# HF_LARGE_MODEL=meta-llama/Llama-3.3-70B-Instruct

# NVIDIA_API_KEY=
# NVIDIA_SMALL_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_LARGE_MODEL=meta/llama-3.3-70b-instruct

# GITHUB_TOKEN=
# GITHUB_SMALL_MODEL=gpt-4o-mini
# GITHUB_LARGE_MODEL=gpt-4o

# SAMBANOVA_API_KEY=
# SAMBANOVA_SMALL_MODEL=Meta-Llama-3.1-8B-Instruct
# SAMBANOVA_LARGE_MODEL=Meta-Llama-3.3-70B-Instruct

# COHERE_API_KEY=
# COHERE_SMALL_MODEL=command-r
# COHERE_LARGE_MODEL=command-r-plus

# POLLINATIONS_API_KEY=
# POLLINATIONS_SMALL_MODEL=openai-fast
# POLLINATIONS_LARGE_MODEL=openai

# Waiting-list WhatsApp notify → 01852044051 (BD) / 8801852044051
# CALLMEBOT_APIKEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# WHATSAPP_WEBHOOK_URL=

# --- Accounts & activity log ---
# Who can open /app/logs (comma separated, use the email you sign up with).
# Leave empty while developing locally: every logged-in user can see it.
# In production it MUST be set, otherwise nobody can open the log.
# ADMIN_EMAILS=you@example.com

# Optional permanent storage for hosting (Netlify/Vercel wipe local files).
# Free database at https://upstash.com -> create Redis -> copy the REST URL + token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
